{
  "metadata": { "name": "impairment_change_event", "description": "CW with AWGN that gets disabled at t=1.5s, then re-enabled at t=3s" },
  "devices": [
    {
      "id": "usrp0",
      "channel": 0,
      "rf": {
        "freq_hz": 2450000000.0,
        "rate_sps": 10000000.0,
        "gain_db": 20.0
      }
    }
  ],
  "emitters": [
    {
      "id": "cw1",
      "device": "usrp0",
      "channel": 0,
      "start_after_sec": 0.0,
      "duration_sec": 5.0,
      "waveform": {
        "type": "cw",
        "amplitude": 0.2
      },
      "impairments": {
        "awgn_power": 0.01
      }
    }
  ],
  "events": [
    {
      "target_device": "usrp0",
      "time_sec": 1.5,
      "type": "impairment_change",
      "payload": {
        "emitter_id": "cw1",
        "impairment": "awgn",
        "enabled": false
      }
    },
    {
      "target_device": "usrp0",
      "time_sec": 3.0,
      "type": "impairment_change",
      "payload": {
        "emitter_id": "cw1",
        "impairment": "awgn",
        "enabled": true
      }
    }
  ]
}
